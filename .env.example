# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se commitea (está en .gitignore). Este .env.example sí.

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---

# Pooler, puerto 6543. Es la que usa la app en runtime.
# Los parámetros pgbouncer y connection_limit son obligatorios en serverless:
# sin ellos, cada invocación abre conexiones nuevas y Supabase corta.
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa, puerto 5432. Solo la usa `prisma migrate`, nunca la app.
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---

NEXT_PUBLIC_SUPABASE_URL="https://TU_REF.supabase.co"
# Clave pública (anon / publishable). Es pública a propósito: viaja al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY"

# --- URL del sitio ---

# Base para armar los links de invitación, los QR y el redirect del magic link.
# En local: http://localhost:3000
# En Vercel: https://arma-tu-partido.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
